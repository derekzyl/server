# Velocis Server v3.1 — Environment Config
# Copy this file to .env and edit before running

# Server port (default 3000)
PORT=3000

# Admin key for destructive / management routes
# (query ?key=, X-Admin-Key, Authorization: Bearer, or dashboard login)
ADMIN_KEY=changeme_to_something_secure

# Viewer key for read-only dashboard access (login / cookie session)
VIEWER_KEY=viewer

# When true, dashboard + read APIs require admin or viewer session
# (default false keeps the open dashboard for backward compatibility)
DASHBOARD_AUTH=false

# SQLite database file path (relative to server/)
DB_FILE=./violations.db

# If true, POST /api/violation and /api/heartbeat require a valid API key
REQUIRE_AUTH=false

# Optional global device API key accepted for any device when REQUIRE_AUTH=true
DEVICE_API_KEY=

# Optional Telegram SEVERE alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto-purge window for POST /api/retention (days)
RETENTION_DAYS=90

# CARTO raster basemap key (removes the "API key required" watermark on the map)
# Get one at carto.com/basemaps/apikey
CARTO_API_KEY=
